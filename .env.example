# ---------------------------------------------------------------------------
# Save-Samy — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# ---------------------------------------------------------------------------

# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------- Sanity (site copy only — NO personal data) --------
# Create a project at https://www.sanity.io/manage, then paste its ID below.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# -------- Sanity read token (LOCAL DEV ONLY — never set in production) --------
# Create a read token at https://www.sanity.io/manage → API → Tokens
# (Viewer role is enough). When this is set the app switches to the
# `previewDrafts` perspective so unpublished documents are visible locally.
# Leave blank in production so prod reads only published docs via the CDN.
SANITY_READ_TOKEN=

# -------- Sanity write token (LOCAL DEV ONLY, only needed to run the draft
# seed script scripts/seed-golden-pages-drafts.mjs) --------
# Create an Editor-role token at https://www.sanity.io/manage → API → Tokens.
SANITY_WRITE_TOKEN=

# -------- Supabase (petition signatures — EU/Frankfurt region) --------
# Create a project at https://supabase.com (region: eu-central-1 / Frankfurt),
# run supabase/schema.sql in the SQL editor, then paste values below.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only — do NOT expose to the browser. Used by server actions only.
SUPABASE_SERVICE_ROLE_KEY=

# -------- Petition — anti-abuse --------
# Random string used to one-way-hash submitter IPs. Change this before
# going to production and never commit the real value.
IP_HASH_SALT=change-me-in-production

# -------- Cloudflare Turnstile (bot protection on forms) --------
# Create a widget at https://dash.cloudflare.com → Turnstile → Add site.
# Site key is public (safe in the browser); secret key is server-only.
# When both are unset, the widget hides and server verification passes —
# so dev / preview still work without configuring Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -------- Shelter reviews link --------
# Public Google Maps reviews page for the Veeweyde shelter — shown in the
# "Why this matters" section as a link. Leave blank to hide.
NEXT_PUBLIC_VEEWEYDE_REVIEWS_URL=

# -------- Public reviews page visibility --------
# Set to "1" once the lawyer greenlights publishing third-party public reviews
# (Google Maps, Golden Pages, etc.). When unset: /public-reviews still works
# at the URL (for lawyer review), but is noindex and the nav link is hidden.
# The /testimonials page (visitor-submitted experiences) is always on with
# moderation.
NEXT_PUBLIC_SHOW_PUBLIC_REVIEWS=

# -------- Analytics (optional, GDPR-friendly) --------
# Create a site at https://plausible.io and paste its domain below to enable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
